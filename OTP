# OTP generated code 

import random

# Generate a 6-digit OTP
otp = random.randint(100000, 999999)

print("Your OTP is:", otp)

# Get OTP from the user
user_otp = input("Enter your OTP: ")

# Verify OTP
if user_otp == str(otp):
    print("OTP verified successfully!")
else:
    print("Invalid OTP. Please try again.")

